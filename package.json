{
  "name": "resiliente-chat",
  "version": "2.0.0",
  "description": "Chat efímero con cifrado de extremo a extremo: salas privadas por enlace y mensajes que se autodestruyen.",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "cert": "node scripts/generar-certificado.js",
    "publicar": "node scripts/publicar.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "express": "^4.21.2",
    "helmet": "^7.2.0",
    "ws": "^8.18.0"
  },
  "keywords": [
    "chat",
    "websocket",
    "e2ee",
    "efimero",
    "privacidad"
  ],
  "author": "Matthew Garay",
  "license": "MIT",
  "devDependencies": {
    "selfsigned": "^2.4.1"
  }
}
