# Puerto y dirección de escucha (por defecto 8080, o 8443 si hay certificado)
# PORT=8080
HOST=0.0.0.0

# HTTPS directo (si no se definen, se usa certs/ creado con "npm run cert")
# TLS_CERT=/ruta/cert.pem
# TLS_KEY=/ruta/key.pem

# Orígenes que pueden abrir el WebSocket (separados por comas).
# Vacío = solo el mismo dominio desde el que se sirve la página.
ALLOWED_ORIGINS=

# Pon TRUST_PROXY=true si el servidor está detrás de un proxy (Nginx, Caddy, Cloudflare).
# Así se usa la IP real de X-Forwarded-For para el límite por IP y X-Forwarded-Host para el origen.
TRUST_PROXY=false

# Límites
MAX_ROOM_SIZE=50
MAX_ROOMS=1000
MAX_CONNECTIONS_PER_IP=20
